NEXT_PUBLIC_PORT = 8080
NEXT_PUBLIC_START_PAGE = /README.md

# Signs the session cookies. The application refuses to start without it.
# Replace the placeholder with a long random value of your own — it is only ever
# compared against itself, and it must not be the same as any other deployment's.
SESSION_SECRET = CHANGE-ME-to-a-long-random-value

# Environment variables for CSCode HttpYac REST Client.
env_tokenEndpoint={{oidc}}
env_clientId={{clientId}}
env_clientSecret={{clientSecret}}
env_username={{userName}}
env_password={{password}}