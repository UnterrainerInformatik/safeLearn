WEBSERVER_PORT=8081
PUBLIC_SERVER_URL=http://localhost:8081
PUBLIC_START_PAGE=/md/index.md

LOCAL_DEV_MD_DIR=\path\to\your\local\md
# Use baskslash and drive letters here in this file.
# Don't forget to add your path to the docker-desktop shared drives via
# Settings -> Resources -> File Sharing.
AUTOSCAN=true

# Signs the session cookies. The container refuses to start without it.
# Replace the placeholder with a long random value of your own.
SESSION_SECRET=CHANGE-ME-to-a-long-random-value

INTERNAL_PORT=8080
DOCKER_HUB_USER=gufalcon
DOCKER_IMAGE_NAME=safe-learn