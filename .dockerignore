# ---------------------------------------------------------------------------------*
# This will prevent your local modules and debug logs from being copied onto your 
# Docker image and possibly overwriting modules installed within your image.
# ---------------------------------------------------------------------------------*
node_modules
npm-debug.log
# ignore .git and .cache folders
.git
.cache
# ignore all markdown files (md) beside all README*.md other than README-secret.md
*.md
!README*.md
README-secret.md
# github related files
.github/
# Secrets never go into the image, which is pushed to a public registry.
# keycloak.json (OIDC client secret) is mounted at runtime, at any depth - a
# stale pipeline writing site/keycloak.json cannot bake it in again. The root
# .env is a developer's local one; site/.env (no secrets) still goes in.
**/keycloak*.json
.env
