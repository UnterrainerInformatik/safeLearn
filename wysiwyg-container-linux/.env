WEBSERVER_PORT=8081
PUBLIC_SERVER_URL=http://localhost:8081
PUBLIC_START_PAGE=/md/index.md

LOCAL_DEV_MD_DIR=/path/to/your/local/md
AUTOSCAN=true

# How readers sign in. "none" publishes without any sign-in: no Keycloak, no
# keycloak.json, no login. "keycloak" signs in through Keycloak instead; then
# also uncomment SESSION_SECRET below and the keycloak.json line in
# docker-compose.yml (see docs-wysiwyg.md).
AUTH=none

# The roles every reader holds while AUTH=none, comma-separated. "teacher"
# shows you the teacher content and the teacher, exam and answer switches, as
# an author needs. Delete the line, or leave it empty, and every restricted
# section and file is hidden - which is what a student would see.
READER_ROLES=teacher

# Only for AUTH=keycloak: signs the session cookies, and the container refuses
# to start without it. Replace the placeholder with a long random value.
#SESSION_SECRET=CHANGE-ME-to-a-long-random-value

INTERNAL_PORT=8080
DOCKER_HUB_USER=gufalcon
DOCKER_IMAGE_NAME=safe-learn