{
  "name": "safe-learn",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "nodemon ./app.js",
    "prod": "node -r dotenv/config ./app.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:headed": "node --test --test-concurrency=1 --env-file=test/headed.env \"test/*.test.js\"",
    "test:obsidian": "node --test --test-concurrency=1 \"test/obsidian/*.test.js\"",
    "docs:screenshots": "node tools/obsidian-screenshots.mjs"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.1",
    "@shikijs/transformers": "^1.1.7",
    "axios": "^1.6.7",
    "chokidar": "^4.0.3",
    "dompurify": "^3.0.9",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.18.0",
    "jsdom": "^24.0.0",
    "lucide-static": "^0.357.0",
    "marked": "^12.0.1",
    "marked-shiki": "^1.0.1",
    "mermaid": "^11.12.0",
    "nodemon": "^3.1.5",
    "openid-client": "^5.6.5",
    "pako": "^2.1.0",
    "passport": "^0.7.0",
    "reveal.js": "^5.0.5",
    "shiki": "^1.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "puppeteer": "^25.7.0"
  }
}
